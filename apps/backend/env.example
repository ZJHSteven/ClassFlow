# ClassFlow Rust 后端环境变量示例
#
# 使用方式：
# 1. 复制到服务器上的 `/etc/classflow/backend.env`
# 2. 按实际机器路径、密钥、R2 参数修改
# 3. 由 systemd 的 `EnvironmentFile=` 读取

CLASSFLOW_BIND_ADDR=0.0.0.0:8787
CLASSFLOW_DB_URL=sqlite:///opt/classflow/data/classflow.db?mode=rwc
CLASSFLOW_BEARER_TOKEN=replace-with-a-long-random-token
CLASSFLOW_DEFAULT_SEMESTER=2026-2027-1

CLASSFLOW_TEMP_ROOT=/opt/classflow/tmp
CLASSFLOW_LOCAL_ARTIFACT_ROOT=/opt/classflow/data/artifacts

CLASSFLOW_TASK_WORKER_COUNT=4
CLASSFLOW_DOWNLOAD_CONCURRENCY=4
CLASSFLOW_UPLOAD_CONCURRENCY=2
CLASSFLOW_TRANSCRIBE_CONCURRENCY=2
CLASSFLOW_R2_CONCURRENCY=4
CLASSFLOW_TMP_CLEANUP_HOURS=168
CLASSFLOW_TASK_EVENT_RETENTION_DAYS=30
CLASSFLOW_TASK_EVENT_RETENTION_ROWS_PER_TASK=200

# SmartClass 自动采集器。
# Rust 后端只负责调度、分页、去重与任务入队；真实登录态由受信任的浏览器桥持有，
# 因此这里不保存 HttpOnly Cookie、platform_token 或站点密码。
CLASSFLOW_SMARTCLASS_COLLECTOR_ENABLED=false
CLASSFLOW_SMARTCLASS_BRIDGE_BASE_URL=http://127.0.0.1:8790
CLASSFLOW_SMARTCLASS_POLL_INTERVAL_SECS=600
CLASSFLOW_SMARTCLASS_INITIAL_BACKFILL_DAYS=21
CLASSFLOW_SMARTCLASS_INCREMENTAL_LOOKBACK_DAYS=2
CLASSFLOW_SMARTCLASS_PAGE_SIZE=12
CLASSFLOW_SMARTCLASS_REQUEST_TIMEOUT_SECS=30

# 下载链路（aria2c）
CLASSFLOW_ARIA2_BIN=aria2c
CLASSFLOW_DOWNLOAD_RETRY_ATTEMPTS=3
CLASSFLOW_DOWNLOAD_RETRY_WAIT_SECS=3.0
CLASSFLOW_DOWNLOAD_CONNECT_TIMEOUT_SECS=15.0
CLASSFLOW_DOWNLOAD_TIMEOUT_SECS=60.0
CLASSFLOW_DOWNLOAD_SPLIT=6
CLASSFLOW_DOWNLOAD_CONNECTIONS_PER_SERVER=6
# 设为 0 表示默认不因为“速度慢”主动失败；只有你明确填正数时才启用低速退出。
CLASSFLOW_DOWNLOAD_LOWEST_SPEED_LIMIT_BYTES=0

# local / r2 / worker
CLASSFLOW_ARTIFACT_STORE_MODE=worker
CLASSFLOW_ARTIFACT_PROXY_BASE_URL=https://classflow.zjhstudio.com/
CLASSFLOW_ARTIFACT_PROXY_TOKEN=replace-with-worker-artifact-token
# 如果 `CLASSFLOW_ARTIFACT_PROXY_BASE_URL` 指向的 Worker 域名被 Cloudflare Access 保护，
# 后端写 R2 产物时也必须带 Service Token；否则请求会先被 Access 重定向到登录页，根本到不了 Worker 私有接口。
# 也可以改用通用变量名 `CF_ACCESS_CLIENT_ID` / `CF_ACCESS_CLIENT_SECRET`，后端会自动兼容读取。
CLASSFLOW_ARTIFACT_PROXY_ACCESS_CLIENT_ID=replace-with-access-client-id
CLASSFLOW_ARTIFACT_PROXY_ACCESS_CLIENT_SECRET=replace-with-access-client-secret

# 阿里百炼 / DashScope
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
# 录音文件转写模型。当前默认值改为 `fun-asr-mtl`。
# 如果你后续想切回 `fun-asr`、或切到带日期版本号的固定模型，也只改这一行即可。
# 注意：本值会同时用于“上传临时 oss:// 文件时申请凭证”和“真正提交转写任务”；
# 两边模型名必须完全一致，否则上传成功后仍可能在转写阶段失败。
CLASSFLOW_DASHSCOPE_MODEL=fun-asr-mtl
CLASSFLOW_DASHSCOPE_SUBMIT_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr/transcription
CLASSFLOW_DASHSCOPE_TASK_URL_TEMPLATE=https://dashscope.aliyuncs.com/api/v1/tasks/{task_id}
CLASSFLOW_DASHSCOPE_UPLOAD_POLICY_URL=https://dashscope.aliyuncs.com/api/v1/uploads
CLASSFLOW_DASHSCOPE_REQUEST_TIMEOUT_SECS=60.0
CLASSFLOW_DASHSCOPE_REQUEST_RETRY_ATTEMPTS=3
CLASSFLOW_DASHSCOPE_REQUEST_RETRY_WAIT_SECS=3.0
CLASSFLOW_UPLOAD_RETRY_ATTEMPTS=3
CLASSFLOW_UPLOAD_RETRY_WAIT_SECS=3.0
CLASSFLOW_UPLOAD_TIMEOUT_SECS=900.0
CLASSFLOW_DASHSCOPE_POLL_INTERVAL_SECS=1.0
CLASSFLOW_DASHSCOPE_POLL_TIMEOUT_SECS=900.0

# ASR provider：dashscope / local_qwen / remote_capswriter。
# 当前 N1 生产推荐 remote_capswriter：N1 只保留压缩 M4A checkpoint，重型 Qwen3-ASR
# 固定交给 Windows RTX4060；local_qwen 继续作为离线/回退实验路径保留。
CLASSFLOW_ASR_PROVIDER=remote_capswriter

# 本地 ASR（CapsWriter + Qwen3-ASR）
# 只有把上面的 provider 改为 local_qwen 时，下列本地 sidecar 参数才参与运行。
CLASSFLOW_LOCAL_ASR_PYTHON=/home/zjhsteven/CapsWriter-Offline/.venv/bin/python
CLASSFLOW_LOCAL_ASR_SCRIPT=/opt/classflow/tools/local_asr/local_qwen_asr_once.py
CLASSFLOW_LOCAL_ASR_WORKDIR=/home/zjhsteven/CapsWriter-Offline/CapsWriter-Offline
CLASSFLOW_LOCAL_ASR_MODEL_DIR=/home/zjhsteven/CapsWriter-Offline/CapsWriter-Offline/models/Qwen3-ASR/Qwen3-ASR-1.7B
CLASSFLOW_LOCAL_ASR_ALIGNER_DIR=/home/zjhsteven/CapsWriter-Offline/CapsWriter-Offline/models/Qwen3-ForcedAligner/Qwen3-ForcedAligner-0.6B
CLASSFLOW_LOCAL_ASR_CONCURRENCY=1
# 0 表示沿用 CapsWriter 当前默认线程策略。
# 在这台 4 核 N100 上，上游默认会把解码线程落到 2。
CLASSFLOW_LOCAL_ASR_THREADS=0
# 0 表示沿用上游 batch 线程策略；通常建议和上面的线程数一起调。
CLASSFLOW_LOCAL_ASR_THREADS_BATCH=0
CLASSFLOW_LOCAL_ASR_IDLE_SHUTDOWN_SECS=1800
CLASSFLOW_LOCAL_ASR_START_TIMEOUT_SECS=120
CLASSFLOW_LOCAL_ASR_TASK_TIMEOUT_SECS=0

# N1 生产：把 ASR 交给 Windows RTX4060 上的通用 CapsWriterGateway Job API。
# 2026-10-08 已真实验证：N1 M4A -> asr.zjhstudio.com -> Cloudflare Access/Tunnel ->
# Windows 6017 Gateway -> CapsWriter 6016 -> completed job result。
CLASSFLOW_REMOTE_CAPSWRITER_BASE_URL=https://asr.zjhstudio.com
# 当前公网生产鉴权由 Cloudflare Access 负责，因此 Gateway Bearer 留空即可。
# 如果以后把 Gateway 部署到不经过 Access 的其他网络，可重新启用这一层。
CLASSFLOW_REMOTE_CAPSWRITER_TOKEN=
# 可以填写 ASR 专用变量；若留空，后端依次复用通用 CF_ACCESS_*，或现有
# CLASSFLOW_ARTIFACT_PROXY_ACCESS_CLIENT_*（同一枚 Service Token 时无需复制 secret）。
CLASSFLOW_REMOTE_CAPSWRITER_ACCESS_CLIENT_ID=
CLASSFLOW_REMOTE_CAPSWRITER_ACCESS_CLIENT_SECRET=
CLASSFLOW_REMOTE_CAPSWRITER_REQUEST_TIMEOUT_SECS=30
CLASSFLOW_REMOTE_CAPSWRITER_UPLOAD_TIMEOUT_SECS=900
CLASSFLOW_REMOTE_CAPSWRITER_POLL_INTERVAL_SECS=1
CLASSFLOW_REMOTE_CAPSWRITER_POLL_TIMEOUT_SECS=3600
# Windows/网络临时不可达时不把任务判死：第一次约 30s 后重试，随后指数退避，
# 上限 300s。重试期间保留 audio.m4a 与已提交 remote job id。
CLASSFLOW_REMOTE_CAPSWRITER_RETRY_WAIT_SECS=30
CLASSFLOW_REMOTE_CAPSWRITER_RETRY_MAX_WAIT_SECS=300

# 网络健康闸门。
# 当 Wi-Fi 漫游、网卡重连、代理链路短时不可达导致外部请求失败时，
# 后端会暂停新的外部网络操作，等探针连续成功后再继续，避免把临时断网算成任务失败。
CLASSFLOW_NETWORK_HEALTH_ENABLED=true
CLASSFLOW_NETWORK_HEALTH_PROBE_URLS=https://www.baidu.com,https://dashscope.aliyuncs.com
CLASSFLOW_NETWORK_HEALTH_PROBE_TIMEOUT_SECS=5.0
CLASSFLOW_NETWORK_HEALTH_CHECK_INTERVAL_SECS=5.0
CLASSFLOW_NETWORK_HEALTH_STABLE_SUCCESSES=2

# SmartClass 自动采集。生产默认用 N1 纯 HTTP Session Manager；旧 Windows/CDP bridge
# 只保留为救援模式。Cookie 不写进 env，而是由后端保存到 0600 session 文件。
CLASSFLOW_SMARTCLASS_COLLECTOR_ENABLED=false
CLASSFLOW_SMARTCLASS_TRANSPORT=direct_http
CLASSFLOW_SMARTCLASS_BASE_URL=https://tmu.smartclass.cn
CLASSFLOW_SMARTCLASS_SESSION_FILE=/home/zjhsteven/.local/state/classflow/smartclass-session.json
# 下面 key/IV 来自 SmartClass 当前公开客户端 JS，只用于兼容其 domainConfig / 登录字段加解密，
# 不是用户 secret；站点升级后可覆盖。
CLASSFLOW_SMARTCLASS_CSRF_AES_KEY=80bdbdbaf7494add99198960d715d41b
CLASSFLOW_SMARTCLASS_CSRF_AES_IV=bdbaf7494add9919
CLASSFLOW_SMARTCLASS_BRIDGE_BASE_URL=http://127.0.0.1:8790
CLASSFLOW_SMARTCLASS_POLL_INTERVAL_SECS=600
CLASSFLOW_SMARTCLASS_INITIAL_BACKFILL_DAYS=21
CLASSFLOW_SMARTCLASS_INCREMENTAL_LOOKBACK_DAYS=2
CLASSFLOW_SMARTCLASS_PAGE_SIZE=12
CLASSFLOW_SMARTCLASS_REQUEST_TIMEOUT_SECS=30

# Phase 3 Notes：完整 lecture -> ChatGPT Project -> GitHub Notes。
# 生产环境应把课表快照与仓库一起部署；有匹配课表时，Notes worker 用计划结束时间
# 判断整堂课是否结束，避免仅靠“最后一个已知 45 分钟录像片段”过早封堂。
CLASSFLOW_NOTES_ENABLED=false
CLASSFLOW_NOTES_AUTO_SINCE_DATE=9999-12-31
CLASSFLOW_NOTES_POLL_INTERVAL_SECS=15
# Archive/ChatGPT actor 返回 429 后，全局暂停新的 Notes submission；默认 10 分钟。
CLASSFLOW_COURSE_SCHEDULE_PATH=./config/class-schedule-lifeops.json
# 课表计划结束后再等待一小段时间，给 SmartClass 新录像落库与 Collector 扫描留余量。
CLASSFLOW_NOTES_SCHEDULE_GRACE_MINUTES=15
CLASSFLOW_NOTES_PROJECT_NAME=课堂录音→笔记
CLASSFLOW_ARCHIVE_BRIDGE_BASE_URL=https://archive-bridge.example.com
CLASSFLOW_ARCHIVE_BRIDGE_TOKEN=
CLASSFLOW_ARCHIVE_BRIDGE_ACCESS_CLIENT_ID=
CLASSFLOW_ARCHIVE_BRIDGE_ACCESS_CLIENT_SECRET=
CLASSFLOW_ARCHIVE_BRIDGE_REQUEST_TIMEOUT_SECS=30
CLASSFLOW_NOTES_GITHUB_REPO=owner/med-notes-repo
CLASSFLOW_NOTES_GITHUB_TOKEN=replace-with-github-token

# Cloudflare R2（仅在 CLASSFLOW_ARTIFACT_STORE_MODE=r2 时由后端直连使用）
CLASSFLOW_R2_BUCKET=replace-with-r2-bucket
CLASSFLOW_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLASSFLOW_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLASSFLOW_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLASSFLOW_R2_REGION=auto

# 持久化流水线通知 outbox；事件先落 SQLite，再由 webhook adapter 异步发送。
CLASSFLOW_NOTIFICATIONS_ENABLED=false
CLASSFLOW_NOTIFICATION_WEBHOOK_URL=
CLASSFLOW_NOTIFICATION_WEBHOOK_TOKEN=
CLASSFLOW_NOTIFICATION_POLL_INTERVAL_SECS=15
CLASSFLOW_NOTIFICATION_MAX_ATTEMPTS=8

# 课堂 Notes 的第三轮摘要邮件。邮件失败独立重试，不影响 Notes/GitHub 成功状态。
CLASSFLOW_SUMMARY_EMAIL_ENABLED=false
CLASSFLOW_SUMMARY_EMAIL_WEBHOOK_URL=
CLASSFLOW_SUMMARY_EMAIL_POLL_INTERVAL_SECS=30
CLASSFLOW_SUMMARY_EMAIL_MAX_ATTEMPTS=8

# 历史 succeeded Notes 的第三轮摘要回填。默认关闭；建议先用 ONLY_LECTURE_KEY 做单条 canary。
# 回填严格复用原 conversation，只补摘要，不重做 Notes/标题，也不重新发布 GitHub。
CLASSFLOW_SUMMARY_BACKFILL_ENABLED=false
CLASSFLOW_SUMMARY_BACKFILL_SINCE_DATE=9999-12-31
CLASSFLOW_SUMMARY_BACKFILL_ONLY_LECTURE_KEY=

